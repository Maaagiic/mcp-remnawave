{
  "name": "remnawave-mcp",
  "version": "3.0.0",
  "description": "MCP server for the Remnawave VPN panel (tools generated from the backend contract)",
  "type": "module",
  "bin": {
    "remnawave-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsup src/lib.ts --format esm --target node22 --out-dir .test-build --clean --silent && node --test \"test/*.test.mjs\"",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "mcp",
    "remnawave",
    "vpn",
    "proxy",
    "xray"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@remnawave/backend-contract": "3.4.15",
    "dotenv": "^17.4.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maaagiic/mcp-remnawave.git"
  },
  "homepage": "https://github.com/Maaagiic/mcp-remnawave#readme",
  "bugs": {
    "url": "https://github.com/Maaagiic/mcp-remnawave/issues"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE",
    ".env.example"
  ]
}
