REMNAWAVE_BASE_URL=https://panel.example.com
REMNAWAVE_API_TOKEN=your-api-token-here

# Optional: API key for a reverse proxy in front of the panel (sent as X-Api-Key).
# See: https://docs.remnawave.com/docs/security/caddy-with-custom-path/
# REMNAWAVE_API_KEY=your-proxy-api-key

# Access level. Start in readonly mode: tools that change the panel are not
# registered at all until this is false and the server is restarted.
REMNAWAVE_READONLY=true

# In write mode, "false" also hides tools that delete data or act on every
# user/node at once (users_delete, users_bulk_all_*, nodes_restart_all, ...).
# REMNAWAVE_ALLOW_DESTRUCTIVE=false

# Register only some toolsets (default: all):
#   users, nodes, hosts, config_profiles, squads, hwid, subscriptions,
#   node_plugins, connections, stats, system, billing, raw
# REMNAWAVE_TOOLSETS=users,nodes,hosts,stats

# Leave individual tools out; * is a wildcard.
# REMNAWAVE_TOOLS_EXCLUDE=users_bulk_*,api_request

# Timeout for one request to the panel, milliseconds (default 30000).
# REMNAWAVE_TIMEOUT_MS=30000

# Multi-panel setups: the server looks for config in this order and stops at the
# first file that provides REMNAWAVE_BASE_URL + REMNAWAVE_API_TOKEN:
#   1. $REMNAWAVE_ENV_FILE            explicit path
#   2. <cwd>/.remnawave.env           per-project (add it to .gitignore)
#   3. <cwd>/.env
#   4. <this package>/.env            fallback
# One global install can therefore serve several panels: each project keeps its
# own .remnawave.env, and the active panel is whichever project the client runs in.
